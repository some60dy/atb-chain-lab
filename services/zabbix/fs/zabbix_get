#!/usr/bin/env python3
"""zabbix_get (Zabbix 6.0.18) — query a passive Zabbix agent."""
import argparse
import socket
import struct
import sys

p = argparse.ArgumentParser(prog="zabbix_get")
p.add_argument("-s", "--host", required=True)
p.add_argument("-p", "--port", type=int, default=10050)
p.add_argument("-k", "--key", required=True)
p.add_argument("-t", "--timeout", type=int, default=30)
a = p.parse_args()

payload = a.key.encode()
try:
    s = socket.create_connection((a.host, a.port), timeout=a.timeout)
    s.sendall(b"ZBXD\x01" + struct.pack("<Q", len(payload)) + payload)
    hdr = b""
    while len(hdr) < 13:
        chunk = s.recv(13 - len(hdr))
        if not chunk:
            break
        hdr += chunk
    if len(hdr) < 13:
        sys.exit(f"zabbix_get [{a.host}]: Check access restrictions in Zabbix agent configuration")
    (n,) = struct.unpack("<Q", hdr[5:13])
    buf = b""
    while len(buf) < n:
        chunk = s.recv(min(65536, n - len(buf)))
        if not chunk:
            break
        buf += chunk
    sys.stdout.write(buf.decode("utf-8", "replace").rstrip("\n") + "\n")
except OSError as e:
    sys.exit(f"zabbix_get [{a.host}]: Get value error: {e}")
